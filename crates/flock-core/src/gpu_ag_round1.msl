// ===========================================================================
// AG zerocheck round 1 on the GPU (prototype, v2).
//
// The same sums as the CPU kernel
// `round1_straight_line_program_packed_banks_fused_padded` over Full blocks:
// for each 1024-byte block o (128 rows of 64 bits) with weight eq[o],
//   res[j]   += eq[o] * P_j      (j < 160, the product planes)
//   bank0[k] += eq[o] * (C_k & even rows),  bank1[k] += eq[o] * (C_k & odd rows)
// where a plane is the 128-bit value whose bit r is the coordinate's bit in
// row r, read as an F128.
//
// A 32-thread group takes 8 blocks per batch, 4 threads per block (one per
// 32-row word). v1 kept the bitsliced state (~800 words a thread) and the
// Paar encode's 519 temporaries live and was spill-bound. v2 keeps only a's
// and b's 64 plane words in registers:
// - each encoded word is an unrolled XOR chain straight from M
//   (gpu_ag_round1_gen.msl, generated by scripts/gen_gpu_ag_round1.py),
//   computed when a product needs it, with no temporaries;
// - products go straight to threadgroup memory in three coordinate sets
//   (p < 32: coordinates p, 64+p, 128+p; p >= 32: p, 64+p; then the c banks),
//   laid out so one block's plane is one uint4;
// - each set is folded at once: thread t owns some coordinates of the set and
//   multiplies their 8 block planes by the blocks' eq (nibble tables),
//   accumulating in registers across batches.
// Each group writes 288 partial sums; the host XORs them.
// ===========================================================================

struct AgRound1Params {
    uint n_blocks;   // a multiple of 8
};

// acc += sum over the batch's 8 blocks of eq[bb] * (slot's plane of block bb).
static inline uint4 fold_slot(threadgroup const uint* xch, threadgroup const uint4* tabs,
                              uint slot, uint4 acc) {
    threadgroup const uint4* planes = (threadgroup const uint4*)(xch + slot * 32u);
    for (uint bb = 0u; bb < 8u; bb++) {
        acc ^= gf_mul_tab4(planes[bb], &tabs[bb << 6]);
    }
    return acc;
}

kernel void ag_round1(device const uint2* a          [[buffer(0)]],
                      device const uint2* b          [[buffer(1)]],
                      device const uint2* c          [[buffer(2)]],
                      device const uint4* eq         [[buffer(3)]],
                      device uint4* partial          [[buffer(4)]],
                      constant AgRound1Params& P     [[buffer(5)]],
                      uint tgid    [[threadgroup_position_in_grid]],
                      uint ngroups [[threadgroups_per_grid]],
                      uint lid     [[thread_index_in_threadgroup]])
{
    threadgroup uint4 tabs[8u * 64u];
    threadgroup uint xch[96u * 32u];

    uint4 acc0 = uint4(0u), acc1 = uint4(0u), acc2 = uint4(0u);
    uint4 acc3 = uint4(0u), acc4 = uint4(0u), acc5 = uint4(0u);
    uint4 acc6 = uint4(0u), acc7 = uint4(0u), acc8 = uint4(0u);

    const uint n_batches = P.n_blocks >> 3;
    const uint bi = lid >> 2;
    const uint w = lid & 3u;
    for (uint batch = tgid; batch < n_batches; batch += ngroups) {
        // The batch's 8 eq weights as four-nibble tables (gf_mul_tab4).
        for (uint e = lid; e < 512u; e += 32u) {
            uint bb = e >> 6, ent = e & 63u, k = ent >> 4, n = ent & 15u;
            uint4 base = eq[(batch << 3) + bb];
            for (uint m = 0u; m < 4u * k; m++) { base = gf_mulx(base); }
            uint4 v = uint4(0u);
            for (uint t = 0u; t < 4u; t++) {
                if ((n >> t) & 1u) { v ^= base; }
                base = gf_mulx(base);
            }
            tabs[e] = v;
        }

        const uint row0 = ((batch << 3) + bi) * 128u + 32u * w;
        uint pa[64], pb[64];
        plane_words(a + row0, pa);
        plane_words(b + row0, pb);

        // Set 1: coordinates p, 64+p, 128+p for p < 32.
        products_lo(pa, pb, xch, lid);
        threadgroup_barrier(mem_flags::mem_threadgroup);
        acc0 = fold_slot(xch, tabs, lid, acc0);
        acc1 = fold_slot(xch, tabs, 32u + lid, acc1);
        acc2 = fold_slot(xch, tabs, 64u + lid, acc2);
        threadgroup_barrier(mem_flags::mem_threadgroup);

        // Set 2: coordinates p, 64+p for 32 <= p < 64.
        products_hi(pa, pb, xch, lid);
        threadgroup_barrier(mem_flags::mem_threadgroup);
        acc3 = fold_slot(xch, tabs, lid, acc3);
        acc4 = fold_slot(xch, tabs, 32u + lid, acc4);
        threadgroup_barrier(mem_flags::mem_threadgroup);

        // Set 3: the c banks, even rows then odd rows.
        plane_words(c + row0, pa);
        for (uint k = 0u; k < 64u; k++) { xch[k * 32u + lid] = pa[k] & 0x55555555u; }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        acc5 = fold_slot(xch, tabs, lid, acc5);
        acc6 = fold_slot(xch, tabs, 32u + lid, acc6);
        threadgroup_barrier(mem_flags::mem_threadgroup);
        for (uint k = 0u; k < 64u; k++) { xch[k * 32u + lid] = pa[k] & 0xAAAAAAAAu; }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        acc7 = fold_slot(xch, tabs, lid, acc7);
        acc8 = fold_slot(xch, tabs, 32u + lid, acc8);
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    device uint4* out = partial + tgid * 288u;
    out[lid] = acc0;
    out[64u + lid] = acc1;
    out[128u + lid] = acc2;
    out[32u + lid] = acc3;
    out[96u + lid] = acc4;
    out[160u + lid] = acc5;
    out[192u + lid] = acc6;
    out[224u + lid] = acc7;
    out[256u + lid] = acc8;
}
